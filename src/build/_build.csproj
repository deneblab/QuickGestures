<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace></RootNamespace>
    <Nullable>disable</Nullable>
    <NoWarn>CS0649;CS0169</NoWarn>
    <FalloutRootDirectory>..\..</FalloutRootDirectory>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fallout.Common" Version="10.4.0" />
    <PackageReference Include="Deneblab.AbcVersion" Version="1.2.19" />
    <!-- Fallout.Common 10.4.0 brings in 10.0.10 of these, which has known vulnerabilities -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

</Project>
