{
  "name": "quickgestures",
  "version": "0.3.7",
  "description": "Chrome extension for mouse gestures",
  "private": true,
  "scripts": {
    "build": "npm run typecheck && node esbuild.config.js",
    "typecheck": "tsc --noEmit",
    "watch": "node esbuild.config.js --watch",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "npm run clean && npm run watch"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
