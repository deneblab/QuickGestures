<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The build needs only nuget.org; clearing the machine's sources keeps the restore
       and its vulnerability audit from depending on private feeds in a user NuGet.Config -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
